+# Only the current Health GET adds metadata from the existing authenticated SSH identity.
+# Send PID, native start time and the path-derived number without the executable path.
+MT5_SLOT_METADATA = r'''
+$slots=@()
+try {
+    $slots=@(Get-CimInstance Win32_Process -Filter "Name='terminal64.exe' OR Name='terminal.exe'" -OperationTimeoutSec 3 | ForEach-Object {
+        $path=[string]$_.ExecutablePath
+        if ($_.CreationDate -and [IO.Path]::IsPathRooted($path) -and
+            $path -match '(?:^|[\\/])MetaTrader 5 Slot ?([1-9][0-9]{0,8})[\\/]terminal(?:64)?\.exe$') {
+            @{pid=[int]$_.ProcessId; started_at=$_.CreationDate.ToUniversalTime().ToString('o'); slot=[int]$Matches[1]}
+        }
+    })
+} catch {
+    $slots=@()
+}
+[Console]::WriteLine()
+[Console]::WriteLine(('FLEET_MT5_SLOTS ' + (ConvertTo-Json -InputObject $slots -Compress)))
+'''
+
+
+def process_identity(process):
+    if (isinstance(process, dict) and type(process.get('pid')) is int
+            and isinstance(process.get('started_at'), str)):
+        return process['pid'], process['started_at']
+    return None
+
+
+def apply_current_slots(health, metadata):
+    if not isinstance(metadata, list) or not isinstance(health, dict):
+        return health
+    windows = health.get('windows')
+    if not isinstance(windows, list):
+        return health
+    slots = {}
+    for row in metadata:
+        identity = process_identity(row)
+        if identity is not None and type(row.get('slot')) is int and row['slot'] > 0:
+            slots[identity] = row['slot']
+    for window in windows:
+        last = window.get('last') if isinstance(window, dict) else None
+        processes = last.get('processes') if isinstance(last, dict) else None
+        if not isinstance(processes, list):
+            continue
+        for process in processes:
+            slot = slots.get(process_identity(process))
+            if slot is not None:
+                process['mt5_slot'] = slot
+    return health
+
+
 class VpsUnavailable(OSError):
