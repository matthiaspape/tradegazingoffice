+    def wait_seconds(self):
+        # The background loop wakes exactly when the next read is due (30 s after a failure),
+        # so a read triggered by a request in between never makes it skip a whole cycle.
+        with self.lock:
+            if self.last_attempt is None:
+                return 0.0
+            interval = 30 if self.last_attempt != self.last_success else self.refresh_seconds
+            return min(self.refresh_seconds, max(1.0, self.last_attempt + interval - self.clock()))
