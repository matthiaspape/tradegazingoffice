+def mt5_slot(executable):
+    if not isinstance(executable, str) or not executable:
+        return None
+    path = PureWindowsPath(executable)
+    if not path.is_absolute() or path.name.casefold() not in ('terminal64.exe', 'terminal.exe'):
+        return None
+    match = re.fullmatch(r'MetaTrader 5 Slot ?([1-9][0-9]*)', path.parent.name, re.IGNORECASE)
+    return int(match[1]) if match else None
+
