+            if self.value is None or now - self.last_success > 7 * 86400:
+                self.value = None
+                raise VpsUnavailable('Noch kein erreichbarer VPS-Datenstand')
+            return dict(self.value, connection=dict(
+                state='CURRENT' if self.last_attempt == self.last_success else 'STALE',
+                last_success_at=datetime.fromtimestamp(self.last_success, timezone.utc).isoformat(),
+                last_attempt_at=datetime.fromtimestamp(self.last_attempt, timezone.utc).isoformat(),
