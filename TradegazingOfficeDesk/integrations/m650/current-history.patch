@@ -0,0 +1,173 @@
+"""Read-only, cursor-based Fleet Control projections for the Office client."""
+from collections import OrderedDict
+from datetime import datetime, timezone
+from decimal import Decimal, InvalidOperation
+import json
+import re
+from secrets import token_hex
+from threading import Lock
+
+from . import health
+from .projection import corrected, desk, number, scope
+from .vendor.read_api import Reader
+
+HOURS = (24, 168)
+REVISIONS = 12
+
+
+def history_query(query):
+    if set(query) - {'hours', 'after'} or len(query.get('hours', [])) != 1:
+        raise ValueError('Specify a history window')
+    hours = int(query['hours'][0])
+    after = query.get('after', [''])[0]
+    if hours not in HOURS or (after and not re.fullmatch(r'[0-9a-f]{32}', after)):
+        raise ValueError('Invalid history window or cursor')
+    return hours, after
+
+
+def current(config, part):
+    if part == 'desk':
+        return dict(desk(config, current_only=True), host_id=config['host_id'])
+    if part == 'health':
+        return health.read(config, days=7, current_only=True)
+    raise ValueError('Unknown current data part')
+
+
+def instant(iso):
+    return datetime.fromisoformat(iso.replace('Z', '+00:00')).timestamp()
+
+
+def fraction(used, total):
+    try:
+        if isinstance(used, bool) or isinstance(total, bool):
+            return None
+        n, d = Decimal(str(used)), Decimal(str(total))
+        if n.is_finite() and d.is_finite() and 0 <= n <= d and d > 0:
+            return float(n * 100 / d)
+    except InvalidOperation:
+        pass
+    return None
+
+
+def utilization(total, free):
+    try:
+        size, spare = Decimal(str(total)), Decimal(str(free))
+        if size.is_finite() and spare.is_finite() and 0 <= spare <= size and size > 0:
+            used = size - spare
+            return int(used), fraction(used, size)
+    except InvalidOperation:
+        pass
+    return None, None
+
+
+def health_points(raw, lower, upper):
+    points = {}
+    for window in raw['windows']:
+        last = window['last']
+        stamp = last['observed_at']
+        observed = instant(stamp)
+        slot = window['slot']
+        if not last.get('available') or not lower <= observed <= upper or int(observed // 300) * 300 != slot:
+            continue
+        if slot in points and instant(points[slot]['at']) >= observed:
+            continue
+        total = last.get('total_ram')
+        free = last.get('available_ram')
+        ram = utilization(total, free)[1]
+        volumes = []
+        for volume in last.get('volumes', []):
+            size, unused = volume.get('size'), volume.get('free')
+            used, percent = utilization(size, unused)
+            volumes.append(dict(name=volume['name'], total=size, used=used, percent=percent))
+        points[slot] = dict(at=stamp, cpu=window['cpu_mean'], ram=ram, volumes=volumes)
+    return points
+
+
+def equity_record(raw):
+    row = json.loads(raw)
+    payload = row['payload']
+    row['payload'] = {key: payload[key] for key in ('equity', 'logical_record_id') if key in payload}
+    return row
+
+
+def equity_points(rows, lower, upper):
+    points = {}
+    # Match the original native correction rules before choosing a chart point.
+    for record in corrected(rows):
+        stamp = record['observed_at_utc']
+        observed = instant(stamp)
+        value = record['payload'].get('equity')
+        if not lower <= observed <= upper or number(value) is None:
+            continue
+        key = (*scope(record), record['deployment_id'], int(observed // 300) * 300)
+        if key not in points or instant(points[key]['at']) <= observed:
+            points[key] = dict(at=stamp, value=value)
+    return points
+
+
+def changes(before, after):
+    return {
+        **{key: None for key in before.keys() - after.keys()},
+        **{key: value for key, value in after.items() if before.get(key) != value},
+    }
+
+
+class History:
+    def __init__(self, config, clock=lambda: datetime.now(timezone.utc)):
+        self.config = config
+        self.clock = clock
+        self.lock = Lock()
+        self.views = {hours: OrderedDict() for hours in HOURS}
+        self.rows = []
+        self.highwater = None
+        self.floor = None
+
+    def refresh_equity(self):
+        if not self.config['sources']:
+            return
+        registered = {json.dumps([s['account_key'], s['environment'], s.get('run_id')], separators=(',', ':'))
+                      for s in self.config['sources']}
+        reader = Reader(self.config['database'], self.config['sources'])
+        with reader.open() as db:
+            db.execute('BEGIN')
+            seen = db.execute("SELECT seq FROM sqlite_sequence WHERE name='originals'").fetchone()
+            highwater = seen[0] if seen else 0
+            previous = db.execute("SELECT value FROM office_retention_state WHERE key='cursor_floor'").fetchone()
+            floor = int(previous[0]) if previous else 0
+            reset = self.highwater is None or self.floor != floor or highwater < self.highwater
+            after = 0 if reset else self.highwater
+            additions = [(cursor, equity_record(raw)) for cursor, raw, row_scope in db.execute(
+                "SELECT id,first_record,scope FROM originals WHERE id>? AND id<=? "
+                "AND type='account_snapshot' ORDER BY id", (after, highwater)) if row_scope in registered]
+        if self.highwater is not None and highwater < self.highwater:
+            for view in self.views.values():
+                view.clear()
+        if reset:
+            self.rows = additions
+        else:
+            self.rows.extend(additions)
+        self.highwater, self.floor = highwater, floor
+
+    def read(self, hours, after):
+        with self.lock:
+            self.refresh_equity()
+            now = self.clock().timestamp()
+            lower = now - hours * 3600
+            rows = sorted(self.rows, key=lambda row: (row[1]['observed_at_utc'], row[0]))
+            equity = equity_points([row for _, row in rows], lower, now)
+            host = health_points(health.read(self.config, days=hours // 24), lower, now)
+            view = self.views[hours]
+            latest = next(reversed(view), None)
+            token = latest
+            if latest is None or view[latest] != (equity, host):
+                token = token_hex(16)
+                view[token] = (equity, host)
+            base = view.get(after)
+            while len(view) > REVISIONS:
+                view.popitem(last=False)
+            equity_delta, health_delta = equity, host
+            if base is not None:
+                equity_delta, health_delta = changes(base[0], equity), changes(base[1], host)
+            return dict(cursor=token, reset=base is None, host_id=self.config['host_id'],
+                        equity=[[list(key[:-1]), key[-1], value] for key, value in equity_delta.items()],
+                        health=list(health_delta.items()))
