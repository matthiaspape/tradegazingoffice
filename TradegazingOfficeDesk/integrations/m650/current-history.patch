+class CurrentRead:
+    def __init__(self, part, transport, clock, refresh_seconds):
+        self.part, self.transport, self.clock = part, transport, clock
+        self.refresh_seconds = refresh_seconds
+        self.value = self.last_success = self.last_attempt = None
+        self.lock = threading.Lock()
+
+    def snapshot(self):
+        with self.lock:
+            now = self.clock()
+            stale = self.last_attempt != self.last_success
+            if self.last_attempt is None or now - self.last_attempt >= (30 if stale else self.refresh_seconds):
+                self.last_attempt = now
+                try:
+                    value = self.transport.fetch('/v1/current?' + urlencode(dict(part=self.part)))
